generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  draft
  needs_review
  published
  archived
}

enum UserRole {
  site_admin
  data_admin
  editor
  contributor
  fact_checker
  writer
  curator
  translator
}

enum TeamVisibility {
  private
  public
}

enum PublicationStatus {
  unpublished
  published
  archived
}

enum WorkflowStatus {
  needs_review
  fact_checked
  populated
  polished
}

enum InstagramType {
  post
  reel
  carousel
  unknown
}

enum MatchStatus {
  imported
  suggested
  needs_review
  matched
  ignored
  published
}

enum Confidence {
  low
  medium
  high
}

enum RelationshipType {
  guru
  disciple
  parent
  child
  father
  mother
  son
  daughter
  husband
  wife
  partner
  incarnation
  family
  influence
  initiator
  patron
  successor
  debate_opponent
  contemporary
  associated
  lineage
  related
  untyped
}

enum RelationshipEvidenceStatus {
  certain
  probable
  traditional
  disputed
  imported
  uncategorized
}

enum FamilyMemberRole {
  head
  subgroup_head
  member
  partner
  incarnation
  successor
  associated
}

enum MuseumSectionAssignmentType {
  primary
  alternative
}

enum MuseumSectionTier {
  featured
  secondary
  tertiary
}

enum AliasType {
  alternate_spelling
  title
  regional_name
  transliteration
  instagram_name
  airtable_name
  other
}

enum PlaceType {
  primary
  birth
  samadhi
  sadhana
  associated
  other
}

enum PlaceScope {
  locality
  state
  country
}

enum PlaceKind {
  country
  region
  state
  district
  city
  town
  village
  sacred_site
  ashram
  temple
  monastery
  neighborhood
  route_area
  spiritual_region
  locality
  unknown
}

enum PlaceRelationshipType {
  contained_in
  part_of
  near
  associated_region
  historical_alias_of
  successor_name_of
}

enum SourceType {
  book
  article
  website
  scripture
  oral_tradition
  other
}

enum ImportSourceType {
  airtable
  instagram
  csv
  manual
}

enum ReconciliationStatus {
  open
  resolved
  ignored
}

enum AssignmentContentType {
  saint
  tradition
  place
  instagram_item
}

enum AssignmentState {
  assigned
  in_progress
  blocked
  completed
  cancelled
}

enum AssignmentPriority {
  low
  normal
  high
  urgent
}

enum AdminEntityType {
  saint
  tradition
  place
  instagram_item
}

enum FeedbackStatus {
  new
  in_review
  resolved
  spam
  archived
}

enum FeedbackCategory {
  comment_testimony
  correction
  source_citation
  name_spelling
  missing_information
  technical_issue
  other
}

enum FeedbackEntityType {
  saint
  tradition
  place
  page
}

enum InstagramDerivedClaimType {
  alias
  birth_date
  guru
  place
  samadhi_date
  tradition
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  roles         UserRole[] @default([fact_checker])
  active        Boolean    @default(true)
  lastSignedInAt DateTime?
  accessAudits  AdminAccessAudit[]
  assignedContentTasks ContentAssignment[] @relation("AssignmentAssignee")
  createdContentTasks  ContentAssignment[] @relation("AssignmentCreator")
  completedContentTasks ContentAssignment[] @relation("AssignmentCompleter")
  editConflicts AdminEditConflict[]
  createdEditorialDrafts AdminEditorialDraft[] @relation("EditorialDraftCreator")
  updatedEditorialDrafts AdminEditorialDraft[] @relation("EditorialDraftUpdater")
  createdEditorialRevisions EditorialRevision[] @relation("EditorialRevisionCreator")
  updatedEditorialRevisions EditorialRevision[] @relation("EditorialRevisionUpdater")
  reviewedEditorialRevisions EditorialRevision[] @relation("EditorialRevisionReviewer")
  publishedEditorialRevisions EditorialRevision[] @relation("EditorialRevisionPublisher")
  adminPresence AdminPresence[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ContentAssignment {
  id            String                @id @default(cuid())
  contentType   AssignmentContentType
  contentId     String
  taskType      String
  assigneeId    String?
  assignee      User?                 @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedById  String
  assignedBy    User                  @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  state         AssignmentState       @default(assigned)
  priority      AssignmentPriority    @default(normal)
  dueDate       DateTime?
  notes         String?
  completedById String?
  completedBy   User?                 @relation("AssignmentCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  completedAt   DateTime?

  @@index([assigneeId, state, dueDate])
  @@index([contentType, contentId, state])
  @@index([state, priority, createdAt])
}

model AdminEditConflict {
  id              String          @id @default(cuid())
  entityType      AdminEntityType
  entityId        String
  expectedVersion Int
  currentVersion  Int
  currentValue    Json
  attemptedValue  Json
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model AdminEditorialDraft {
  id              String          @id @default(cuid())
  entityType      AdminEntityType
  entityId        String
  section         String
  payload         Json
  baseVersion     Int
  revision        Int             @default(1)
  createdById     String
  createdBy       User            @relation("EditorialDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById     String
  updatedBy       User            @relation("EditorialDraftUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([entityType, entityId, section])
  @@index([entityType, entityId, updatedAt])
  @@index([updatedById, updatedAt])
}

model EditorialRevision {
  id            String          @id @default(cuid())
  entityType    AdminEntityType
  entityId      String
  section       String
  status        ContentStatus   @default(draft)
  activeKey     String?         @unique
  payload       Json
  basePayload   Json
  baseVersion   Int
  createdById   String
  createdBy     User            @relation("EditorialRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String
  updatedBy     User            @relation("EditorialRevisionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    User?           @relation("EditorialRevisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedById String?
  publishedBy   User?           @relation("EditorialRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([entityType, entityId, section, updatedAt])
  @@index([status, submittedAt])
}

model AdminPresence {
  id         String          @id @default(cuid())
  entityType AdminEntityType
  entityId   String
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       String          @default("viewing")
  expiresAt  DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([entityType, entityId, userId])
  @@index([entityType, entityId, expiresAt])
  @@index([expiresAt])
}

model AdminAccessAudit {
  id           String     @id @default(cuid())
  targetUserId String
  targetUser   User       @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  actorEmail   String
  action       String
  beforeRoles  UserRole[]
  afterRoles   UserRole[]
  beforeActive Boolean
  afterActive  Boolean
  createdAt    DateTime   @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Saint {
  id                       String                  @id @default(cuid())
  slug                     String                  @unique
  canonicalName            String
  displayName              String
  shortDescription         String?
  biographySummary         String?
  status                   ContentStatus           @default(draft)
  teamVisibility           TeamVisibility          @default(private)
  publicationStatus        PublicationStatus       @default(unpublished)
  workflowStatus           WorkflowStatus          @default(needs_review)
  featured                 Boolean                 @default(false)
  launchMvp                Boolean                 @default(false)
  hasInstagramContent      Boolean                 @default(false)
  primaryImageId           String?
  primaryImage             MediaAsset?             @relation("PrimarySaintImage", fields: [primaryImageId], references: [id])
  foundedTraditions        Tradition[]             @relation("TraditionFounder")
  eraLabel                 String?
  birthDateRaw             String?
  birthYear                Int?
  birthYearEnd             Int?
  birthMonth               Int?
  birthDay                 Int?
  birthDatePrecision       String?
  samadhiDateRaw           String?
  samadhiYear              Int?
  samadhiYearEnd           Int?
  samadhiMonth             Int?
  samadhiDay               Int?
  samadhiDatePrecision     String?
  dateNotes                String?
  seoTitle                 String?
  seoDescription           String?
  aliases                  SaintAlias[]
  biographies              Biography[]
  galleryImages            SaintGalleryImage[]
  instagramItems           InstagramItemSaint[]
  places                   SaintPlace[]
  instagramClaims          InstagramDerivedClaim[] @relation("InstagramClaimAppliedSaint")
  relationshipsFrom        SaintRelationship[]     @relation("RelationshipFrom")
  relationshipsTo          SaintRelationship[]     @relation("RelationshipTo")
  familyMemberships        SaintFamilyMember[]
  museumSectionAssignments SaintMuseumSection[]
  homeQuoteConfigs         HomePageConfig[]        @relation("HomeQuoteSaint")
  traditionLineageEntries  TraditionLineageSaint[] @relation("TraditionLineageSaint")
  traditionLineageChildren TraditionLineageSaint[] @relation("TraditionLineageParentSaint")
  traditions               SaintTradition[]
  slugRedirects            SaintSlugRedirect[]
  createdById              String?
  updatedById              String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  publishedAt              DateTime?
  reviewedAt               DateTime?
  version                  Int                     @default(1)

  @@index([status, featured, displayName])
  @@index([teamVisibility, publicationStatus, workflowStatus, displayName])
}

model SaintSlugRedirect {
  id        String   @id @default(cuid())
  slug      String   @unique
  saintId   String
  saint     Saint    @relation(fields: [saintId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([saintId])
}

model SaintAlias {
  id        String    @id @default(cuid())
  saintId   String
  saint     Saint     @relation(fields: [saintId], references: [id], onDelete: Cascade)
  alias     String
  aliasType AliasType @default(other)
  source    String?
  createdAt DateTime  @default(now())

  @@index([alias])
}

model Tradition {
  id                       String                      @id @default(cuid())
  slug                     String                      @unique
  name                     String
  alternateNames           String[]
  shortDescription         String?
  longIntroductionMarkdown String?
  historyMarkdown          String?
  foundingAcharyaMarkdown  String?
  keyTeachingsMarkdown     String?
  heroImageId              String?
  heroImage                MediaAsset?                 @relation("TraditionHeroImage", fields: [heroImageId], references: [id])
  status                   ContentStatus               @default(draft)
  teamVisibility           TeamVisibility              @default(private)
  publicationStatus        PublicationStatus           @default(unpublished)
  workflowStatus           WorkflowStatus              @default(needs_review)
  founderSaintId           String?
  founderSaint             Saint?                      @relation("TraditionFounder", fields: [founderSaintId], references: [id], onDelete: SetNull)
  founderDisplayName       String?
  origin                   String?
  eraLabel                 String?
  focus                    String?
  originPlaceId            String?
  originPlace              Place?                      @relation("TraditionOriginPlace", fields: [originPlaceId], references: [id], onDelete: SetNull)
  originPlaceLabel         String?
  parentTraditionId        String?
  parentTradition          Tradition?                  @relation("TraditionParent", fields: [parentTraditionId], references: [id])
  childTraditions          Tradition[]                 @relation("TraditionParent")
  seoTitle                 String?
  seoDescription           String?
  saints                   SaintTradition[]
  galleryImages            TraditionGalleryImage[]
  lineageSaints            TraditionLineageSaint[]
  relatedPlaces            TraditionRelatedPlace[]
  relatedTraditions        TraditionRelatedTradition[] @relation("RelatedTraditionSource")
  relatedByTraditions      TraditionRelatedTradition[] @relation("RelatedTraditionTarget")
  scripturalBasis          TraditionScripturalBasis[]
  homeFeaturedPlacements   HomeFeaturedTraditionPlacement[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  version                  Int                         @default(1)
  publishedAt              DateTime?

  @@index([status, name])
  @@index([teamVisibility, publicationStatus, workflowStatus, name])
}

model Place {
  id                     String                  @id @default(cuid())
  slug                   String                  @unique
  name                   String
  alternateNames         String[]
  teamVisibility         TeamVisibility          @default(private)
  publicationStatus      PublicationStatus       @default(unpublished)
  workflowStatus         WorkflowStatus          @default(needs_review)
  placeKind              PlaceKind               @default(locality)
  placeScope             PlaceScope              @default(locality)
  parentStateId          String?
  parentState            Place?                  @relation("PlaceState", fields: [parentStateId], references: [id], onDelete: SetNull)
  localities             Place[]                 @relation("PlaceState")
  region                 String?
  country                String?
  overviewMarkdown       String?
  latitude               Decimal?
  longitude              Decimal?
  notes                  String?
  saints                 SaintPlace[]
  relationshipsFrom      PlaceRelationship[]     @relation("PlaceRelationshipFrom")
  relationshipsTo        PlaceRelationship[]     @relation("PlaceRelationshipTo")
  traditionOrigins       Tradition[]             @relation("TraditionOriginPlace")
  traditionRelatedPlaces TraditionRelatedPlace[]
  version                Int                     @default(1)

  @@index([placeKind])
  @@index([placeScope])
  @@index([parentStateId])
  @@index([teamVisibility, publicationStatus, workflowStatus, name])
}

model PlaceRelationship {
  id               String                @id @default(cuid())
  fromPlaceId      String
  fromPlace        Place                 @relation("PlaceRelationshipFrom", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlaceId        String
  toPlace          Place                 @relation("PlaceRelationshipTo", fields: [toPlaceId], references: [id], onDelete: Cascade)
  relationshipType PlaceRelationshipType
  confidence       Confidence            @default(high)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([fromPlaceId, toPlaceId, relationshipType])
  @@index([fromPlaceId, relationshipType])
  @@index([toPlaceId, relationshipType])
}

model SaintPlace {
  id              String      @id @default(cuid())
  saintId         String
  saint           Saint       @relation(fields: [saintId], references: [id], onDelete: Cascade)
  placeId         String
  place           Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeType       PlaceType   @default(associated)
  notes           String?
  routeOrder      Int?
  routeLabel      String?
  routeConfidence Confidence?

  @@index([saintId, routeOrder])
  @@index([placeId, placeType])
}

model SaintTradition {
  id          String    @id @default(cuid())
  saintId     String
  saint       Saint     @relation(fields: [saintId], references: [id], onDelete: Cascade)
  traditionId String
  tradition   Tradition @relation(fields: [traditionId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(false)
  notes       String?

  @@unique([saintId, traditionId])
  @@index([traditionId, isPrimary])
}

model TraditionLineageSaint {
  id            String    @id @default(cuid())
  traditionId   String
  tradition     Tradition @relation(fields: [traditionId], references: [id], onDelete: Cascade)
  saintId       String
  saint         Saint     @relation("TraditionLineageSaint", fields: [saintId], references: [id], onDelete: Cascade)
  sortOrder     Int       @default(0)
  roleLabel     String?
  parentSaintId String?
  parentSaint   Saint?    @relation("TraditionLineageParentSaint", fields: [parentSaintId], references: [id], onDelete: SetNull)

  @@unique([traditionId, saintId])
  @@index([traditionId, sortOrder])
  @@index([parentSaintId])
}

model TraditionRelatedTradition {
  id                 String    @id @default(cuid())
  traditionId        String
  tradition          Tradition @relation("RelatedTraditionSource", fields: [traditionId], references: [id], onDelete: Cascade)
  relatedTraditionId String
  relatedTradition   Tradition @relation("RelatedTraditionTarget", fields: [relatedTraditionId], references: [id], onDelete: Cascade)
  sortOrder          Int       @default(0)
  label              String?

  @@unique([traditionId, relatedTraditionId])
  @@index([traditionId, sortOrder])
}

model TraditionRelatedPlace {
  id          String    @id @default(cuid())
  traditionId String
  tradition   Tradition @relation(fields: [traditionId], references: [id], onDelete: Cascade)
  placeId     String
  place       Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  label       String?

  @@unique([traditionId, placeId])
  @@index([traditionId, sortOrder])
}

model TraditionScripturalBasis {
  id          String    @id @default(cuid())
  traditionId String
  tradition   Tradition @relation(fields: [traditionId], references: [id], onDelete: Cascade)
  title       String
  sourceId    String?
  source      Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  url         String?
  note        String?
  sortOrder   Int       @default(0)

  @@index([traditionId, sortOrder])
  @@index([sourceId])
}

model SaintRelationship {
  id                  String                     @id @default(cuid())
  fromSaintId         String
  fromSaint           Saint                      @relation("RelationshipFrom", fields: [fromSaintId], references: [id], onDelete: Cascade)
  toSaintId           String
  toSaint             Saint                      @relation("RelationshipTo", fields: [toSaintId], references: [id], onDelete: Cascade)
  relationshipType    RelationshipType
  status              ContentStatus              @default(needs_review)
  evidenceStatus      RelationshipEvidenceStatus @default(imported)
  confidence          Confidence                 @default(medium)
  publicVisible       Boolean                    @default(false)
  displayOrder        Int                        @default(0)
  publicNote          String?
  notes               String?
  internalNotes       String?
  sourceId            String?
  source              Source?                    @relation(fields: [sourceId], references: [id])
  externalRecordId    String?
  externalRecord      ExternalRecord?            @relation(fields: [externalRecordId], references: [id], onDelete: SetNull)
  importJobId         String?
  importJob           AirtableImportJob?         @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  relationshipSources SaintRelationshipSource[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([fromSaintId, relationshipType, status])
  @@index([toSaintId, relationshipType, status])
  @@index([status, publicVisible])
  @@index([externalRecordId])
  @@index([importJobId])
}

model SaintRelationshipSource {
  id               String            @id @default(cuid())
  relationshipId   String
  relationship     SaintRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  sourceId         String?
  source           Source?           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalRecordId String?
  externalRecord   ExternalRecord?   @relation(fields: [externalRecordId], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime          @default(now())

  @@unique([relationshipId, sourceId])
  @@unique([relationshipId, externalRecordId])
  @@index([sourceId])
  @@index([externalRecordId])
}

model SaintFamily {
  id                  String              @id @default(cuid())
  slug                String              @unique
  displayName         String
  descriptionMarkdown String?
  status              ContentStatus       @default(needs_review)
  publicVisible       Boolean             @default(false)
  graphVersion        String?
  computedFrom        String?
  sourceExternalId    String?
  notes               String?
  members             SaintFamilyMember[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, publicVisible])
}

model SaintFamilyMember {
  id               String             @id @default(cuid())
  familyId         String
  family           SaintFamily        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  saintId          String
  saint            Saint              @relation(fields: [saintId], references: [id], onDelete: Cascade)
  role             FamilyMemberRole   @default(member)
  tier             MuseumSectionTier?
  sortOrder        Int                @default(0)
  notes            String?
  externalRecordId String?
  externalRecord   ExternalRecord?    @relation(fields: [externalRecordId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([familyId, saintId])
  @@index([saintId])
  @@index([familyId, sortOrder])
  @@index([externalRecordId])
}

model DuplicateCandidate {
  id                    String               @id @default(cuid())
  entityType            String
  entityId              String?
  candidateEntityId     String?
  sourceType            String?
  sourceExternalId      String?
  confidence            Confidence           @default(medium)
  evidenceJson          Json?
  message               String?
  status                ReconciliationStatus @default(open)
  reconciliationIssueId String?
  reconciliationIssue   ReconciliationIssue? @relation(fields: [reconciliationIssueId], references: [id], onDelete: SetNull)
  reviewedById          String?
  resolvedAt            DateTime?
  resolutionNotes       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([entityType, entityId, candidateEntityId, sourceType, sourceExternalId])
  @@index([entityType, entityId, status])
  @@index([candidateEntityId])
  @@index([reconciliationIssueId])
}

model MuseumSection {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  descriptionMarkdown String?
  sortOrder           Int                  @default(0)
  status              ContentStatus        @default(needs_review)
  publicVisible       Boolean              @default(false)
  assignments         SaintMuseumSection[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, publicVisible, sortOrder])
}

model SaintMuseumSection {
  id                    String                      @id @default(cuid())
  saintId               String
  saint                 Saint                       @relation(fields: [saintId], references: [id], onDelete: Cascade)
  museumSectionId       String
  museumSection         MuseumSection               @relation(fields: [museumSectionId], references: [id], onDelete: Cascade)
  assignmentType        MuseumSectionAssignmentType @default(primary)
  tier                  MuseumSectionTier           @default(secondary)
  confidence            Confidence                  @default(medium)
  rationale             String?
  internalPlacementNote String?
  status                ContentStatus               @default(needs_review)
  externalRecordId      String?
  externalRecord        ExternalRecord?             @relation(fields: [externalRecordId], references: [id], onDelete: SetNull)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([saintId, museumSectionId, assignmentType])
  @@index([saintId, assignmentType])
  @@index([museumSectionId, assignmentType, tier])
  @@index([status])
  @@index([externalRecordId])
}

model MediaAsset {
  id                         String                  @id @default(cuid())
  url                        String
  storageKey                 String?
  altText                    String?
  caption                    String?
  credit                     String?
  sourceUrl                  String?
  width                      Int?
  height                     Int?
  mimeType                   String?
  variants                   Json?
  focalX                     Float                   @default(50)
  focalY                     Float                   @default(30)
  homeBannerConfigs          HomePageConfig[]        @relation("HomeBannerImage")
  homeTraditionBannerConfigs HomePageConfig[]        @relation("HomeFeaturedTraditionBannerImage")
  homeTraditionPlacementBanners HomeFeaturedTraditionPlacement[] @relation("HomeFeaturedTraditionPlacementBanner")
  aboutHeroConfigs           SiteConfig[]            @relation("AboutHeroImage")
  aboutVisionConfigs         SiteConfig[]            @relation("AboutVisionImage")
  aboutStoryConfigs          SiteConfig[]            @relation("AboutStoryImage")
  aboutGuruConfigs           SiteConfig[]            @relation("AboutGuruImage")
  saintsIndexHeroConfigs     SiteConfig[]            @relation("SaintsIndexHeroImage")
